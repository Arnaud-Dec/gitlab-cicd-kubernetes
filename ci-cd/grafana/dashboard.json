                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "max(rate(process_cpu_seconds_total[5m])) * 1000",
                        "legendFormat": "CPU (millicœurs)",
                        "range": true
