DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=todos
DB_SSLMODE=disable
HTTP_PORT=8080
HEALTH_PORT=9090
FRONTEND_ORIGIN=http://localhost:5173
# CORS is disabled by default (secure-by-default: same-origin only). The
# frontend dev server (:5173) and this API (:8080) are different origins, so
# local dev needs it on:
CORS_ENABLED=true
