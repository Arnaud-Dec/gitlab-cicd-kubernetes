DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=todos
DB_SSLMODE=disable
HTTP_PORT=8080
HEALTH_PORT=9090
FRONTEND_ORIGIN=http://localhost:5173
# Accepts a comma-separated list if the frontend needs to be reachable on
# more than one origin/port at once, e.g.:
# FRONTEND_ORIGIN=http://localhost:5173,http://localhost:4000
# Only used when CORS_ENABLED is true — see below.

# CORS headers are always sent; this only picks the policy. false (the
# default) allows any origin (Access-Control-Allow-Origin: *) — a permissive
# default so local dev and ad hoc testing just work regardless of what port
# the frontend runs on. Set to true to restrict it to FRONTEND_ORIGIN instead.
CORS_ENABLED=false
